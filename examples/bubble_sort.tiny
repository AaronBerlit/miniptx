// Bubble sort, using a helper that receives the array by reference
// RUN: bubble_sort [5,2,9,1,5,6] 6
// EXPECT: a = [1, 2, 5, 5, 6, 9]
// RUN: bubble_sort [] 0
// EXPECT: a = []
func swap(int a[], int i, int j) {
    int tmp = a[i];
    a[i] = a[j];
    a[j] = tmp;
}

func bubble_sort(int a[], int n) {
    int i = 0;
    while (i < n - 1) {
        int j = 0;
        while (j < n - 1 - i) {
            if (a[j] > a[j + 1]) {
                swap(a, j, j + 1);
            }
            j = j + 1;
        }
        i = i + 1;
    }
}
