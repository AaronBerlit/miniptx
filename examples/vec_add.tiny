// Element-wise vector add: c = a + b (one loop does every element)
// RUN: vec_add [1,2,3] [10,20,30] [0,0,0] 3
// EXPECT: a = [1, 2, 3]
// EXPECT: b = [10, 20, 30]
// EXPECT: c = [11, 22, 33]
func vec_add(float a[], float b[], float c[], int n) {
    int i = 0;
    while (i < n) {
        c[i] = a[i] + b[i];
        i = i + 1;
    }
}
