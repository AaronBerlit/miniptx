// Dot product of two float vectors
// RUN: dot [1,2,3] [4,5,6] 3
// EXPECT: return = 32
// EXPECT: x = [1, 2, 3]
// EXPECT: y = [4, 5, 6]
func dot(float x[], float y[], int n) -> float {
    float acc = 0.0;
    int i = 0;
    while (i < n) {
        acc = acc + x[i] * y[i];
        i = i + 1;
    }
    return acc;
}
