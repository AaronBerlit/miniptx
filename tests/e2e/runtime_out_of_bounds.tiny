// RUN: get [10,20,30] 2
// EXPECT: return = 30
// EXPECT: a = [10, 20, 30]
// RUN: get [10,20,30] 3
// EXPECT: runtime error: index 3 is out of bounds for array 'a' (size 3)
// RUN: get [10,20,30] -1
// EXPECT: runtime error: index -1 is out of bounds for array 'a' (size 3)
func get(int a[], int i) -> int {
    return a[i];
}
